{
  "cleanUrls": true,
  "redirects": [
    { "source": "/en", "destination": "/?lang=en", "permanent": false },
    { "source": "/fr", "destination": "/?lang=fr", "permanent": false },
    { "source": "/ja", "destination": "/?lang=ja", "permanent": false },
    { "source": "/ko", "destination": "/?lang=ko", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(menu-data|script|admin)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
